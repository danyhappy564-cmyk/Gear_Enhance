<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../LocalSettings.props" Condition="Exists('../../LocalSettings.props')" />
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>GearEnhance.Client</AssemblyName>
    <Version>1.4.2</Version>
    <SptRoot Condition="'$(SptRoot)' == '' and '$(SPT_ROOT)' != ''">$(SPT_ROOT)</SptRoot>
    <SptRoot Condition="'$(SptRoot)' == ''">E:\SPT 4.1</SptRoot>
    <Managed>$(SptRoot)/EscapeFromTarkov_Data/Managed</Managed>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Audio/*.wav" LogicalName="GearEnhance.Audio.%(Filename)%(Extension)" />
    <!-- Mockup fonts (UiFonts.cs): loaded from BepInEx/plugins/GearEnhance/fonts beside the DLL. -->
    <None Include="Fonts/*.ttf;Fonts/OFL-*.txt" Link="fonts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- 1.4.1 translations (LangFiles.cs): the master table in the DLL, player-editable files in BepInEx/plugins/GearEnhance/lang. -->
    <EmbeddedResource Include="Lang/strings.tsv" LogicalName="GearEnhance.Lang.strings.tsv" />
    <None Include="Lang/ru.tsv;Lang/zh.tsv;Lang/template.tsv" Link="lang/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../Shared/*.cs" Link="Shared/%(Filename)%(Extension)" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" ExcludeAssets="runtime" />
    <Reference Include="BepInEx"><HintPath>$(SptRoot)/BepInEx/core/BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(SptRoot)/BepInEx/core/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(Managed)/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Managed)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(Managed)/UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(Managed)/UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(Managed)/UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(Managed)/UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="RequireGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(SptRoot)/BepInEx/core/BepInEx.dll')" Text="LocalSettings.props의 SptRoot 또는 SPT_ROOT에 실제 SPT 4.1 설치 경로를 지정하세요." />
  </Target>
</Project>
